# Copy to .env and fill in real values. Never commit .env.
# Primary model: Space Bunny Alpha via OpenRouter
# Calls pin provider {"only": ["stealth"], "allow_fallbacks": false} and
# stream responses, so no extra configuration is needed for routing.
# OpenCode Zen (PRIMARY provider, highest cascade priority)
# Zen speaks the OpenAI *chat completions* protocol. The documented
# .../v1/responses path returns HTTP 400 "ModelProtocolUnsupported" for most
# models, so point the client at the /v1 root and let the SDK append
# /chat/completions. The orchestrator also normalises a /responses value
# automatically, so either form works.
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# muse-spark-1.3 is a paid model and returns HTTP 402 "Insufficient account
# funds" on an unfunded account. Use a free-tier model until Zen has credit.
OPENCODE_ZEN_MODEL=space-bunny-free
# OpenRouter (cascade fallback #1, used when Zen fails)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stealth/space-bunny-alpha
# Fallback #2: NVIDIA NIM via NVIDIA_API_KEY (accepted when
# NVIDIA_NIM_API_KEY is empty).
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
# NVIDIA_API_KEY=your_alternate_nvidia_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Vision is deliberately NOT routed through Zen: it stays on NVIDIA NIM
# (meta/llama-3.2-11b-vision-instruct), which is proven to accept base64
# image payloads. Do not point this at a Zen model without testing vision
# support first.
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Product-cover image generation (core/image_generator.py) via NVIDIA's
# genai endpoint with the SAME NVIDIA_NIM_API_KEY above — no extra key.
# FLUX.1-dev is the proven default (HTTP 200 on live probe). Qwen-Image
# proper is NOT reachable with our keys (absent from NIM/Zen catalogs;
# OpenRouter key cannot afford image calls) — needs a DashScope key.
# NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# USDA FoodData Central validation (required for products containing kcal
# claims; obtain a free key at https://fdc.nal.usda.gov/api-key-signup.html).
USDA_API_KEY=your_usda_api_key_here
# Telegram build notifications (optional; pipeline runs without them)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Payhip publishing: Payhip offers NO public REST product-upload endpoint,
# so the publisher NEVER guesses a URL. Leave PAYHIP_API_URL unset to use
# the manifest-only path (publish_ready/payhip_product.json prepared for
# manual upload); the pipeline treats this as non-blocking success.
# Only set PAYHIP_API_URL if Payhip/a proxy ever provides an upload endpoint.
# PAYHIP_API_URL=https://your-upload-endpoint.example.com
PAYHIP_API_KEY=your_payhip_api_key_here
